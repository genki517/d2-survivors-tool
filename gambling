(function() {
    const UI_ID = 'd2s-gamble-helper-v1';
    if (document.getElementById(UI_ID)) {
        document.getElementById(UI_ID).remove();
    }

    // --- 1. 建立獨立懸浮視窗 ---
    const panel = document.createElement('div');
    panel.id = UI_ID;
    panel.style.cssText = `
        position: fixed; top: 80px; right: 20px; width: 330px;
        background: rgba(18, 16, 14, 0.95); color: #e6d5b8;
        border: 2px solid #8c6d46; border-radius: 6px; padding: 12px;
        z-index: 999999; font-family: "Microsoft JhengHei", sans-serif; font-size: 13px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.85); user-select: none;
    `;

    panel.innerHTML = `
        <div id="gh-header" style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #5c472c;padding-bottom:6px;margin-bottom:10px;cursor:move;">
            <strong style="color:#f0c060;font-size:14px;">🎲 賭博助手 v3.9.2 (畫面提示滿包版)</strong>
            <button id="gh-close" style="background:#7a1c1c;color:#fff;border:1px solid #a33;border-radius:3px;cursor:pointer;padding:1px 7px;">✕</button>
        </div>

        <div style="margin-bottom:8px;">
            <div style="color:#b8a07e;margin-bottom:4px;">保留目標品級：</div>
            <label style="margin-right:6px;cursor:pointer;color:#c7b377;"><input type="checkbox" id="gh-r-unique" checked> 暗金</label>
            <label style="margin-right:6px;cursor:pointer;color:#00e600;"><input type="checkbox" id="gh-r-set" checked> 套裝</label>
            <label style="margin-right:6px;cursor:pointer;color:#ffff4d;"><input type="checkbox" id="gh-r-rare" checked> 黃裝</label>
            <label style="cursor:pointer;color:#66ccff;"><input type="checkbox" id="gh-r-magic" checked> 藍裝</label>
        </div>

        <div style="margin-bottom:8px;">
            <div style="color:#b8a07e;margin-bottom:4px;">🎯 指定單一磁條：</div>
            <select id="gh-mod-select" style="width:100%;box-sizing:border-box;background:#0d0c0a;color:#fff;border:1px solid #5c472c;padding:5px;border-radius:3px;cursor:pointer;">
                <option value="classskills0">👑 亞馬遜技能等級 (classskills0)</option>
                <option value="skilltab0">🏹 弓技能 (skilltab0)</option>
                <option value="skilltab2">⚡ 標槍技能 (skilltab2)</option>
            </select>
            <div style="display:flex;align-items:center;gap:6px;margin-top:6px;background:#14120f;border:1px solid #3d3020;padding:6px;border-radius:3px;">
                <label style="display:flex;align-items:center;gap:4px;color:#e6d5b8;font-size:12px;cursor:pointer;white-space:nowrap;">
                    <input type="checkbox" id="gh-use-min-lv" checked> 自訂最低等級：
                </label>
                <input type="number" id="gh-min-skill-lv" value="2" min="1" max="20" step="1"
                    style="width:64px;background:#0d0c0a;color:#fff;border:1px solid #5c472c;padding:3px 6px;border-radius:3px;">
                <span style="color:#b8a07e;font-size:11px;white-space:nowrap;">以上保留</span>
            </div>
        </div>

        <div style="margin-bottom:10px;">
            <div style="color:#b8a07e;font-size:11px;margin-bottom:2px;">動作間隔 (ms)</div>
            <input type="number" id="gh-delay" value="200" min="100" max="2000" step="20"
                style="width:100%;box-sizing:border-box;background:#0d0c0a;color:#fff;border:1px solid #5c472c;padding:4px;border-radius:3px;">
        </div>

        <div style="background:#14120f;border:1px solid #3d3020;padding:8px;border-radius:4px;margin-bottom:8px;font-size:12px;">
            <div style="color:#f0c060;margin-bottom:6px;font-weight:bold;">🎯 購買點擊座標設定：</div>
            <div style="display:flex;gap:6px;margin-bottom:6px;">
                <div style="flex:1;">相對 X: <input type="number" id="gh-target-x" value="100" style="width:100%;background:#0d0c0a;color:#fff;border:1px solid #5c472c;padding:3px;"></div>
                <div style="flex:1;">相對 Y: <input type="number" id="gh-target-y" value="100" style="width:100%;background:#0d0c0a;color:#fff;border:1px solid #5c472c;padding:3px;"></div>
            </div>
            <div style="display:flex;gap:6px;">
                <button id="gh-pick-btn" style="flex:2;background:#5a4a2a;color:#fff;border:1px solid #8c6d46;padding:5px;border-radius:3px;cursor:pointer;font-weight:bold;font-size:11px;">🎯 點擊畫面抓取座標</button>
                <button id="gh-test-btn" style="flex:1;background:#2b4a20;color:#fff;border:1px solid #4a8f3b;padding:5px;border-radius:3px;cursor:pointer;font-weight:bold;font-size:11px;">🧪 測試點擊</button>
            </div>
        </div>

        <div style="display:flex;gap:8px;margin-bottom:8px;">
            <button id="gh-start" style="flex:1;background:#2b5e20;color:#fff;border:1px solid #4a8f3b;padding:7px;border-radius:4px;cursor:pointer;font-weight:bold;">▶ 開始自動狂賭</button>
            <button id="gh-stop" style="flex:1;background:#7a1c1c;color:#fff;border:1px solid #a33;padding:7px;border-radius:4px;cursor:pointer;font-weight:bold;" disabled>⏹ 停止</button>
        </div>

        <div id="gh-stats" style="background:#0d0c0a;border:1px solid #3d3020;padding:6px;border-radius:4px;font-size:12px;line-height:1.5;">
            狀態：<span id="gh-status" style="color:#aaa;">待機中（請先設定座標）</span><br>
            本次已抽：<span id="gh-count" style="color:#fff;">0</span> 次 ｜ 命中保留：<span id="gh-hits" style="color:#f0c060;">0</span> 件
        </div>
    `;
    document.body.appendChild(panel);

    let isDragging = false, offsetX = 0, offsetY = 0;
    const header = document.getElementById('gh-header');
    header.onmousedown = (e) => {
        if (e.target.id === 'gh-close') return;
        isDragging = true;
        offsetX = e.clientX - panel.offsetLeft;
        offsetY = e.clientY - panel.offsetTop;
    };
    document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        panel.style.left = (e.clientX - offsetX) + 'px';
        panel.style.top = (e.clientY - offsetY) + 'px';
        panel.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => isDragging = false);

    let isPicking = false;
    let running = false;
    let timer = null;
    let rollCount = 0;
    let hitCount = 0;

    const statusEl = document.getElementById('gh-status');
    const countEl = document.getElementById('gh-count');
    const hitsEl = document.getElementById('gh-hits');
    const startBtn = document.getElementById('gh-start');
    const stopBtn = document.getElementById('gh-stop');
    const pickBtn = document.getElementById('gh-pick-btn');
    const modSelectEl = document.getElementById('gh-mod-select');
    const useMinLvEl = document.getElementById('gh-use-min-lv');
    const minSkillLvEl = document.getElementById('gh-min-skill-lv');

    const syncMinLvInput = () => {
        minSkillLvEl.disabled = !useMinLvEl.checked;
        minSkillLvEl.style.opacity = useMinLvEl.checked ? '1' : '0.5';
    };
    useMinLvEl.addEventListener('change', syncMinLvInput);
    syncMinLvInput();

    const setStatus = (msg, color = '#e6d5b8') => {
        statusEl.textContent = msg;
        statusEl.style.color = color;
    };

    const playBeep = () => {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(880, ctx.currentTime);
            osc.frequency.setValueAtTime(1174.66, ctx.currentTime + 0.12);
            gain.gain.setValueAtTime(0.2, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.4);
        } catch (e) {}
    };

    const getSaveData = () => {
        const raw = localStorage.getItem('d2-survivors/save/v1');
        const cls = localStorage.getItem('d2-survivors/class/v1') || 'amazon';
        return { save: JSON.parse(raw), cls };
    };

    pickBtn.onclick = () => {
        const storePanel = document.getElementById('store-panel');
        if (!storePanel || storePanel.offsetParent === null) {
            alert('請先手動打開遊戲內的「賭博」視窗！');
            return;
        }
        isPicking = true;
        pickBtn.style.background = '#8c6d46';
        setStatus('🎯 抓取中：請在遊戲商店內你想買的物品上點一下...', '#66ccff');
    };

    document.addEventListener('click', (e) => {
        if (!isPicking) return;
        const storePanel = document.getElementById('store-panel');
        if (!storePanel) return;

        const r = storePanel.getBoundingClientRect();
        const ox = Math.round(e.clientX - r.x);
        const oy = Math.round(e.clientY - r.y);

        document.getElementById('gh-target-x').value = ox;
        document.getElementById('gh-target-y').value = oy;

        isPicking = false;
        pickBtn.style.background = '#5a4a2a';
        setStatus(`✅ 座標抓取成功！相對位置 (X: ${ox}, Y: ${oy})`, '#00ff88');
        e.stopPropagation();
        e.preventDefault();
    }, true);

    const simulateClick = (el, x, y, shiftKey = false) => {
        if (!el) return;
        const reactKey = Object.keys(el).find(k => k.startsWith('__reactProps$') || k.startsWith('__reactInternalInstance$'));
        if (reactKey && el[reactKey]) {
            const props = el[reactKey];
            const eventObj = {
                bubbles: true, cancelable: true, clientX: x, clientY: y,
                button: 0, buttons: 1, shiftKey: shiftKey,
                preventDefault: () => {}, stopPropagation: () => {}, target: el, currentTarget: el
            };
            if (typeof props.onClick === 'function') props.onClick(eventObj);
            if (typeof props.onMouseDown === 'function') props.onMouseDown(eventObj);
            if (typeof props.onMouseUp === 'function') props.onMouseUp(eventObj);
            if (typeof props.onPointerDown === 'function') props.onPointerDown(eventObj);
            if (typeof props.onPointerUp === 'function') props.onPointerUp(eventObj);
        }

        const opts = {
            bubbles: true, cancelable: true, view: window,
            clientX: x, clientY: y, button: 0, buttons: 1,
            shiftKey: shiftKey, pointerId: 1, pointerType: 'mouse'
        };
        el.dispatchEvent(new PointerEvent('pointerdown', opts));
        el.dispatchEvent(new MouseEvent('mousedown', opts));
        el.dispatchEvent(new PointerEvent('pointerup', opts));
        el.dispatchEvent(new MouseEvent('mouseup', opts));
        el.dispatchEvent(new MouseEvent('click', opts));
    };

    document.getElementById('gh-test-btn').onclick = () => {
        const storePanel = document.getElementById('store-panel');
        if (!storePanel || storePanel.offsetParent === null) {
            alert('請先打開賭博視窗！');
            return;
        }
        const r = storePanel.getBoundingClientRect();
        const ox = Number(document.getElementById('gh-target-x').value) || 0;
        const oy = Number(document.getElementById('gh-target-y').value) || 0;
        const x = r.x + ox;
        const y = r.y + oy;
        const targetEl = document.elementFromPoint(x, y) || storePanel;
        simulateClick(targetEl, x, y, false);
        setStatus('🧪 已執行測試點擊，請檢查金幣或物品有無扣款', '#66ccff');
    };

    const stopBot = (reason, color = '#ff6b6b') => {
        running = false;
        if (timer) clearTimeout(timer);
        startBtn.disabled = false;
        stopBtn.disabled = true;
        setStatus(reason, color);
    };

    document.getElementById('gh-close').onclick = () => {
        stopBot('已關閉');
        panel.remove();
    };

    const getTargetRarities = () => {
        const list = [];
        if (document.getElementById('gh-r-unique').checked) list.push('unique');
        if (document.getElementById('gh-r-set').checked) list.push('set');
        if (document.getElementById('gh-r-rare').checked) list.push('rare');
        if (document.getElementById('gh-r-magic').checked) list.push('magic');
        return list;
    };

    const step = async () => {
        if (!running) return;

        const storePanel = document.getElementById('store-panel');
        const invEl = document.getElementById('inventory');
        if (!storePanel || storePanel.offsetParent === null || !invEl) {
            return stopBot('找不到賭博視窗，請先打開賭博介面！');
        }

        const { save, cls } = getSaveData();
        const delay = Math.max(100, Number(document.getElementById('gh-delay').value) || 200);

        const invList = save.inventoryByClass[cls] || [];

        // 【第一層防護】：如果內部格子大於或等於 32 格，直接停機[cite: 1]
        if (invList.length >= 32) {
            playBeep();
            return stopBot('🎒 背包已滿 (大於32格)！已自動停機', '#00ff88');
        }

        const targetRarities = getTargetRarities();
        if (targetRarities.length === 0) {
            return stopBot('請至少勾選一種目標品級！');
        }

        const targetStat = modSelectEl.value.trim().toLowerCase();
        const useMinLv = useMinLvEl.checked;
        const minSkillLevel = Number(minSkillLvEl.value) || 1;
        const beforeIds = new Set(invList.map(it => it.id));

        const r = storePanel.getBoundingClientRect();
        const ox = Number(document.getElementById('gh-target-x').value) || 0;
        const oy = Number(document.getElementById('gh-target-y').value) || 0;
        const buyX = r.x + ox;
        const buyY = r.y + oy;
        const buyEl = document.elementFromPoint(buyX, buyY) || storePanel;

        setStatus(`正在狂賭中...`, '#e6d5b8');
        simulateClick(buyEl, buyX, buyY, false);
        rollCount++;
        countEl.textContent = rollCount;

        timer = setTimeout(() => {
            if (!running) return;

            // 【第二層防護】：檢查遊戲畫面上有沒有跳出「沒有空間放置此物品」的提示文字[cite: 1]
            const bodyText = document.body.innerText || '';
            if (bodyText.includes('沒有空間放置此物品') || bodyText.includes('No space')) {
                playBeep();
                return stopBot('🎒 偵測到畫面提示「背包已滿」！已自動停機', '#00ff88');
            }

            const afterData = getSaveData();
            const afterInv = afterData.save.inventoryByClass[afterData.cls] || [];

            // 如果買了之後背包長度沒有增加（代表根本買不進去，背包滿了）[cite: 1]
            if (afterInv.length === invList.length) {
                playBeep();
                return stopBot('🎒 背包空間已滿無法購入！已自動停機', '#00ff88');
            }

            const newItem = afterInv.find(it => !beforeIds.has(it.id));
            if (!newItem) {
                timer = setTimeout(step, delay);
                return;
            }

            const isRarityMatch = targetRarities.includes(newItem.rarity);
            const modsArray = newItem.mods || [];

            // 只比對選定的單一條 stat（例如 classskills0 / skilltab0 / skilltab2），並依勾選決定是否檢查等級 >= minSkillLevel
            const isModMatch = modsArray.some(m => {
                const statMatch = (m.stat || '').toLowerCase() === targetStat;
                if (!statMatch) return false;
                if (!useMinLv) return true;
                return Number(m.value) >= minSkillLevel;
            });

            // 命中目標不停止，保留在背包繼續賭[cite: 1]
            if (isRarityMatch && isModMatch) {
                hitCount++;
                hitsEl.textContent = hitCount;
                playBeep();
                setStatus(`✨ 命中保留！[${newItem.rarity.toUpperCase()}] ${newItem.name || newItem.base}`, '#00ff88');
                timer = setTimeout(step, delay);
                return;
            }

            // 未命中 -> 自動賣出[cite: 1]
            const invRect = invEl.getBoundingClientRect();
            const cellW = invRect.width / 10;
            const cellH = invRect.height / 4;
            const sellX = invRect.x + (newItem.at.x + 0.5) * cellW;
            const sellY = invRect.y + (newItem.at.y + 0.5) * cellH;
            const sellEl = document.elementFromPoint(sellX, sellY) || invEl;

            simulateClick(sellEl, sellX, sellY, true);

            timer = setTimeout(step, delay);
        }, Math.max(120, Math.floor(delay * 0.75)));
    };

    startBtn.onclick = () => {
        if (running) return;
        running = true;
        startBtn.disabled = true;
        stopBtn.disabled = false;
        step();
    };

    stopBtn.onclick = () => stopBot('手動停止', '#f0c060');
})();
