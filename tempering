(function () {
    if (document.getElementById('ds-temper-helper')) {
        document.getElementById('ds-temper-helper').remove();
    }

    async function sendTelegramNotice(message) {
        const token = localStorage.getItem('ds_tg_token') || '9021881742:AAGgYEyHQ3PCVmCKkeED7622ecM88KMFH3U';
        const chatId = localStorage.getItem('ds_tg_chatid') || '1658876455';
        if (!token || !chatId) return;
        try {
            await fetch(`https://api.telegram.org/bot${token}/sendMessage?chat_id=${chatId}&text=${encodeURIComponent(message)}`);
        } catch (e) {}
    }

    window.__dsPacketLog = window.__dsPacketLog || [];
    window.__dsLatestForgeT = {};
    window.__dsResetCount = window.__dsResetCount || 0;
    window.__dsReconnectCount = window.__dsReconnectCount || 0;

    const PROBE_INTERVAL_MS = 60000; // 每 1 分鐘檢測一次
    const PROBE_WAIT_PACKET_MS = 4500;
    const PROBE_ALERT_EVERY_COUNT = 5; // 累積滿 5 次（5 分鐘）發一次通知
    const CLEAR_CLOSE_MAX_RETRY = 5; // 清除後仍在介面重試點擊禁止上限 5 次

    let netState = {
        isDisconnected: false,
        initialAlertSent: false,
        retryFailCount: 0,
        lastActivityTime: Date.now(),
        probeTimer: null,
        probeInFlight: false
    };

    let state = {
        running: false,
        calibrating: null,
        charsiPos: JSON.parse(localStorage.getItem('ds_charsi_pos') || '{"x": 1124, "y": 550}'),
        npcTemperPos: JSON.parse(localStorage.getItem('ds_npc_temper_pos') || '{"x": 1124, "y": 480}'),
        npcClearPos: JSON.parse(localStorage.getItem('ds_npc_clear_pos') || '{"x": 1124, "y": 520}'),
        temperPos: JSON.parse(localStorage.getItem('ds_temper_pos') || '{"x": 715, "y": 780}'),
        cancelPos: JSON.parse(localStorage.getItem('ds_cancel_pos') || '{"x": 815, "y": 780}'),
        tgToken: localStorage.getItem('ds_tg_token') || '9021881742:AAGgYEyHQ3PCVmCKkeED7622ecM88KMFH3U',
        tgChatId: localStorage.getItem('ds_tg_chatid') || '1658876455'
    };

    function stopPassiveProbeLoop() {
        if (netState.probeTimer) {
            clearInterval(netState.probeTimer);
            netState.probeTimer = null;
        }
        netState.probeInFlight = false;
    }

    function isInTemperInterface() {
        const helper = document.getElementById('ds-temper-helper');
        const testBox = document.getElementById('ds-ui-detector-test');
        const probeBox = document.getElementById('ds-probe-test');
        const els = Array.from(document.querySelectorAll('div, button, span, p, label, canvas'));
        let visibleDomCount = 0;

        for (const el of els) {
            if (!el) continue;
            if (helper && helper.contains(el)) continue;
            if (testBox && testBox.contains(el)) continue;
            if (probeBox && probeBox.contains(el)) continue;
            const style = window.getComputedStyle(el);
            if (style.display === 'none' || style.visibility === 'hidden' || parseFloat(style.opacity) === 0) continue;
            const r = el.getBoundingClientRect();
            if (r.width <= 1 || r.height <= 1) continue;
            visibleDomCount++;
        }

        let cleanText = (document.body && document.body.innerText) ? document.body.innerText : '';
        if (helper && helper.innerText) cleanText = cleanText.replace(helper.innerText, '');
        if (testBox && testBox.innerText) cleanText = cleanText.replace(testBox.innerText, '');
        if (probeBox && probeBox.innerText) cleanText = cleanText.replace(probeBox.innerText, '');
        const hasStackNumberText = /\b\d{1,3}\b/.test(cleanText.trim());

        return visibleDomCount >= 75 || (visibleDomCount >= 55 && hasStackNumberText);
    }

    async function stopForNotInTemperInterface(stageLabel = '') {
        state.running = false;
        stopPassiveProbeLoop();
        netState.isDisconnected = false;
        netState.initialAlertSent = false;
        netState.retryFailCount = 0;
        const statusEl = document.getElementById('ds-status');
        if (statusEl) {
            statusEl.innerText = `🛑 不在淬鍊介面${stageLabel ? ` (${stageLabel})` : ''}，已停止防誤點地圖！`;
            statusEl.style.color = '#e74c3c';
        }
        await sendTelegramNotice('⚠️ D2 Survivors 警告：目前不在淬鍊介面中，已自動停止淬煉以避免誤點地圖！');
    }

    function isTemperPacket(jsonObj, rawStr) {
        if (!rawStr) return false;
        if (jsonObj && (jsonObj.forge !== undefined || jsonObj.outcome !== undefined || jsonObj.line !== undefined)) {
            return true;
        }
        return false;
    }

    function hasServerDisconnectSignal(jsonObj, rawStr, httpStatus) {
        if (typeof httpStatus === 'number' && (httpStatus === 0 || httpStatus >= 500 || httpStatus === 408 || httpStatus === 429)) {
            return true;
        }
        if (jsonObj && (jsonObj.disconnected === true || jsonObj.overload === true)) {
            return true;
        }
        if (rawStr) {
            const lower = rawStr.toLowerCase();
            const strictKeywords = [
                'overload', 'overloaded', 'connection lost', 'server busy',
                '伺服器過載', '連線中斷', '無法連接', '伺服器忙碌'
            ];
            if (strictKeywords.some(k => lower.includes(k))) {
                return true;
            }
        }
        return false;
    }

    // 反向同步目前淬煉與命中次數至自定義校正輸入框
    function reverseSyncCurrentCountsToCustomInputs() {
        const hits1El = document.getElementById('ds-sync-hits1');
        const hits2El = document.getElementById('ds-sync-hits2');
        const totalEl = document.getElementById('ds-sync-total');

        const affix1 = document.getElementById('ds-target-affix1') ? document.getElementById('ds-target-affix1').value.trim().toLowerCase() : '';
        const affix2 = document.getElementById('ds-target-affix2') ? document.getElementById('ds-target-affix2').value.trim().toLowerCase() : '';
        const forgeT = window.__dsLatestForgeT || {};

        let totalTries = 0;
        for (let k in forgeT) {
            totalTries += (parseInt(forgeT[k]) || 0);
        }

        const c1 = (affix1 && forgeT[affix1]) ? (parseInt(forgeT[affix1]) || 0) : 0;
        const c2 = (affix2 && forgeT[affix2]) ? (parseInt(forgeT[affix2]) || 0) : 0;

        if (hits1El) hits1El.value = Math.min(10, Math.max(0, c1));
        if (hits2El) hits2El.value = Math.min(10, Math.max(0, c2));
        if (totalEl) totalEl.value = Math.min(10, Math.max(0, totalTries));
    }

    // 觸發「斷線繼續淬煉」接續流程（套用自定義次數、清零輸入框並接續）
    function triggerDisconnectResume() {
        if (parseInt(document.getElementById('ds-essence-count').value) <= 0) {
            document.getElementById('ds-status').innerText = '❌ 恐懼精華不可為 0！';
            return false;
        }
        applyAndResetManualCalibrationCounts();
        stopPassiveProbeLoop();
        netState.isDisconnected = false;
        netState.initialAlertSent = false;
        netState.retryFailCount = 0;
        netState.lastActivityTime = Date.now();
        window.__dsReconnectCount++;
        document.getElementById('ds-status').innerText = '🔄 已套用自定義次數並清零輸入框，接續淬煉中...';
        if (!state.running) {
            state.running = true;
            runLoop({ skipNpcOpenIfInInterface: true });
        }
        return true;
    }

    // 改為點擊打勾發送真實封包進行確認；未收到新封包則精華回補 1
    async function runRealClickReconnectCheckOnce() {
        if (!netState.isDisconnected || netState.probeInFlight) return;
        if (!isInTemperInterface()) {
            await stopForNotInTemperInterface('重連打勾檢測時不在介面');
            return;
        }

        const essenceInput = document.getElementById('ds-essence-count');
        let currentEssence = parseInt(essenceInput ? essenceInput.value : 0) || 0;
        if (currentEssence <= 0) {
            state.running = false;
            stopPassiveProbeLoop();
            const statusEl = document.getElementById('ds-status');
            if (statusEl) statusEl.innerText = '❌ 恐懼精華已歸零，無法執行重連打勾檢測！';
            await sendTelegramNotice('⚠️ D2 Survivors 助手警示：恐懼精華已耗盡歸零，停止重連檢測！');
            return;
        }

        netState.probeInFlight = true;
        netState.retryFailCount++;
        const attemptNum = netState.retryFailCount;

        // 暫扣 1 顆精華執行打勾測試，若未收到新封包會回補 1
        essenceInput.value = currentEssence - 1;
        const checkStartTime = Date.now();
        const statusEl = document.getElementById('ds-status');
        if (statusEl) {
            statusEl.innerText = `🔁 離線重連檢測 (第 ${attemptNum} 次)：點擊打勾確認封包中...`;
            statusEl.style.color = '#e09f3e';
        }

        simulateClick(state.temperPos.x, state.temperPos.y);

        let receivedPacket = null;
        const waitStart = Date.now();
        while (Date.now() - waitStart < PROBE_WAIT_PACKET_MS) {
            if (!netState.isDisconnected) break;
            const pkts = window.__dsPacketLog;
            for (let i = pkts.length - 1; i >= 0; i--) {
                if (pkts[i].time >= checkStartTime && pkts[i].isTemper) {
                    receivedPacket = pkts[i];
                    break;
                }
            }
            if (receivedPacket) break;
            await new Promise(r => setTimeout(r, 50));
        }

        netState.probeInFlight = false;

        if (!netState.isDisconnected) {
            // 若期間已被一般封包流程恢復，把剛剛重連檢測暫扣的精華補回，避免重複扣
            const latestEss = parseInt(essenceInput.value) || 0;
            essenceInput.value = latestEss + 1;
            return;
        }

        if (receivedPacket) {
            await handleReconnectConfirmedAutoResume(receivedPacket);
            return;
        }

        // 未收到新封包：精華回補 1，其餘設定維持不變
        const afterEss = parseInt(essenceInput.value) || 0;
        essenceInput.value = afterEss + 1;

        if (statusEl) {
            statusEl.innerText = `⚠️ 未收到封包，精華已回補+1 (已累計 ${attemptNum} 次，每 1 分鐘再測)`;
            statusEl.style.color = '#e74c3c';
        }

        if (attemptNum % PROBE_ALERT_EVERY_COUNT === 0) {
            await sendTelegramNotice(`⚠️ D2 Survivors 警告：連線異常已累計 ${attemptNum} 次（約 ${attemptNum} 分鐘），點擊打勾仍未收到新封包。`);
        }
    }

    async function handleReconnectConfirmedAutoResume(pktItem) {
        if (!netState.isDisconnected) return;
        stopPassiveProbeLoop();
        netState.isDisconnected = false;
        netState.initialAlertSent = false;
        netState.retryFailCount = 0;
        netState.lastActivityTime = Date.now();

        if (pktItem && pktItem.json && pktItem.json.forge && pktItem.json.forge.t) {
            window.__dsLatestForgeT = pktItem.json.forge.t;
        }
        updateUIOnPacket(pktItem ? pktItem.json : null, pktItem ? pktItem.raw : '重連打勾已收到封包');

        reverseSyncCurrentCountsToCustomInputs();

        const statusEl = document.getElementById('ds-status');
        if (statusEl) {
            statusEl.innerText = '✅ 重連確認成功！已反向同步次數，準備自動接續淬煉...';
            statusEl.style.color = '#58d68d';
        }
        await sendTelegramNotice('✅ D2 Survivors 通知：重連打勾已收到封包，已自動同步次數並接續淬煉！');

        triggerDisconnectResume();
    }

    function startPassiveProbeLoop() {
        if (netState.probeTimer) return;
        netState.probeTimer = setInterval(() => {
            runRealClickReconnectCheckOnce();
        }, PROBE_INTERVAL_MS);
    }

    async function markConnectionLost(reasonText = '') {
        if (!isInTemperInterface()) {
            await stopForNotInTemperInterface(`偵測異常時不在介面(${reasonText})`);
            return;
        }
        const wasAlreadyDisconnected = netState.isDisconnected;
        netState.isDisconnected = true;
        if (!wasAlreadyDisconnected) {
            netState.retryFailCount = 0;
        }
        if (!netState.initialAlertSent) {
            netState.initialAlertSent = true;
            await sendTelegramNotice('⚠️ D2 Survivors 警告：網路連線異常，無法連接伺服器！');
        }
        startPassiveProbeLoop();
        const statusEl = document.getElementById('ds-status');
        if (statusEl) {
            statusEl.innerText = `⚠️ 網路連線異常${reasonText ? ` (${reasonText})` : ''}，每 1 分鐘打勾檢測中`;
            statusEl.style.color = '#e74c3c';
        }
    }

    async function markConnectionRecovered(pktItem, reasonLabel = '已收到淬煉封包，恢復連線') {
        if (!netState.isDisconnected) return;
        stopPassiveProbeLoop();
        netState.isDisconnected = false;
        netState.initialAlertSent = false;
        netState.retryFailCount = 0;
        netState.lastActivityTime = Date.now();
        window.__dsReconnectCount++;
        updateUIOnPacket(pktItem ? pktItem.json : null, pktItem ? pktItem.raw : reasonLabel);
        const statusEl = document.getElementById('ds-status');
        if (statusEl) {
            statusEl.innerText = '✅ 連線已恢復！可校正後按「斷線繼續淬煉」';
            statusEl.style.color = '#58d68d';
        }
        await sendTelegramNotice('✅ D2 Survivors 通知：網路連線已恢復！');
    }

    function parseAffixPool(rawStr) {
        let poolSet = new Set();
        if (!rawStr) return [];
        let parts = rawStr.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
        parts.forEach(part => {
            if (part.includes('-')) {
                let rangeParts = part.split('-').map(s => s.trim());
                if (rangeParts.length === 2) {
                    let prefix = rangeParts[0].replace(/[0-9]/g, '');
                    let startNum = parseInt(rangeParts[0].replace(/[^0-9]/g, ''));
                    let endNum = parseInt(rangeParts[1].replace(/[^0-9]/g, ''));
                    if (!isNaN(startNum) && !isNaN(endNum) && startNum <= endNum) {
                        for (let i = startNum; i <= endNum; i++) {
                            poolSet.add(prefix + i);
                        }
                    }
                }
            } else {
                poolSet.add(part);
            }
        });
        return Array.from(poolSet);
    }

    function updateUIOnPacket(jsonObj, rawStr) {
        const trackerEl = document.getElementById('ds-forge-tracker');
        const mode = document.getElementById('ds-mode-select') ? document.getElementById('ds-mode-select').value : '1';
        const affix1 = document.getElementById('ds-target-affix1') ? document.getElementById('ds-target-affix1').value.trim().toLowerCase() : '';
        const affix2 = document.getElementById('ds-target-affix2') ? document.getElementById('ds-target-affix2').value.trim().toLowerCase() : '';
        
        let c1 = (affix1 && window.__dsLatestForgeT[affix1]) ? window.__dsLatestForgeT[affix1] : 0;
        let c2 = (affix2 && window.__dsLatestForgeT[affix2]) ? window.__dsLatestForgeT[affix2] : 0;
        let totalTries = 0;
        for (let k in window.__dsLatestForgeT) { totalTries += (parseInt(window.__dsLatestForgeT[k]) || 0); }

        if (trackerEl) {
            let trackerStr = '裝備詞條狀態：';
            const keys = Object.keys(window.__dsLatestForgeT);
            if (keys.length > 0) {
                trackerStr += keys.map(k => `${k}: ${window.__dsLatestForgeT[k]}次`).join(' | ');
            } else {
                trackerStr += '等待封包同步...';
            }
            trackerEl.innerText = trackerStr;
        }

        const progressEl = document.getElementById('ds-progress');
        if (progressEl) {
            if (mode === '2') {
                const rawPool = document.getElementById('ds-target-pool') ? document.getElementById('ds-target-pool').value : '';
                const poolArr = parseAffixPool(rawPool);
                let poolSum = 0;
                poolArr.forEach(p => { poolSum += (window.__dsLatestForgeT[p] || 0); });
                progressEl.innerText = `總淬煉次數：${totalTries}/10 | 詞條池命中總數：${poolSum}次`;
            } else {
                progressEl.innerText = `總淬煉次數：${totalTries}/10 | 命中統計：目標1(${affix1 || '無'}):${c1}次, 目標2(${affix2 || '無'}):${c2}次`;
            }
        }

        const statsFooterEl = document.getElementById('ds-stats-footer');
        if (statsFooterEl) {
            statsFooterEl.innerText = `重置輪數 : ${window.__dsResetCount} | 斷線重啟次數 : ${window.__dsReconnectCount}`;
        }

        let serverOutcome = 'unknown';
        let serverLine = '';
        try {
            if (jsonObj) {
                if (jsonObj.outcome) serverOutcome = String(jsonObj.outcome).trim().toLowerCase();
                if (jsonObj.line) serverLine = String(jsonObj.line).trim().toLowerCase();
            }
        } catch (e) {}

        let matchedText = '無';
        let matchedColor = '#5dade2';

        if (serverOutcome === 'took') {
            if (mode === '1') {
                if (affix1 && serverLine === affix1) {
                    matchedText = `🎉 命中目標 1 (${affix1})！`;
                    matchedColor = '#58d68d';
                } else if (affix2 && serverLine === affix2) {
                    matchedText = `🎉 命中目標 2 (${affix2})！`;
                    matchedColor = '#58d68d';
                } else {
                    matchedText = `未中指定目標 (line: ${serverLine || 'none'})`;
                    matchedColor = '#e59866';
                }
            } else {
                const rawPool = document.getElementById('ds-target-pool') ? document.getElementById('ds-target-pool').value : '';
                const pool = parseAffixPool(rawPool);
                if (pool.includes(serverLine)) {
                    matchedText = `🎉 命中目標池詞條 (${serverLine})！`;
                    matchedColor = '#58d68d';
                } else {
                    matchedText = `未中目標池 (line: ${serverLine || 'none'})`;
                    matchedColor = '#e59866';
                }
            }
        } else if (serverOutcome === 'missed' || serverOutcome === 'miss') {
            matchedText = `精煉失敗 (missed)`;
            matchedColor = '#e59866';
        }

        const matchedEl = document.getElementById('ds-matched');
        if (matchedEl) {
            matchedEl.innerText = `匹配詞條：${matchedText}`;
            matchedEl.style.color = matchedColor;
        }

        const debugEl = document.getElementById('ds-debug');
        if (debugEl) {
            debugEl.innerText = rawStr;
            debugEl.style.color = serverOutcome === 'took' ? '#58d68d' : '#e59866';
        }
    }

    const analyzeData = (data, httpStatus = 200) => {
        try {
            let rawStr = (typeof data === 'string') ? data : JSON.stringify(data);
            let jsonObj = null;
            if (typeof data === 'string') {
                try { jsonObj = JSON.parse(data); } catch (e) {}
            } else {
                jsonObj = data;
            }

            if (hasServerDisconnectSignal(jsonObj, rawStr, httpStatus)) {
                markConnectionLost(httpStatus ? `HTTP ${httpStatus}` : '伺服器提示');
            } else {
                netState.lastActivityTime = Date.now();
            }

            if (isTemperPacket(jsonObj, rawStr)) {
                if (jsonObj && jsonObj.forge && jsonObj.forge.t) {
                    window.__dsLatestForgeT = jsonObj.forge.t;
                }
                const pktItem = { json: jsonObj, raw: rawStr, time: Date.now(), isTemper: true };
                window.__dsPacketLog.push(pktItem);
                if (window.__dsPacketLog.length > 50) window.__dsPacketLog.shift();
                updateUIOnPacket(jsonObj, rawStr);

                if (netState.isDisconnected && !netState.probeInFlight) {
                    markConnectionRecovered(pktItem);
                }
            }
        } catch (e) {}
    };

    if (!window.__dsXhrHooked) {
        window.__dsXhrHooked = true;
        const origOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function (method, url) { this._url = url; return origOpen.apply(this, arguments); };
        const origSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.send = function (body) {
            const url = this._url || '';
            if (!url.match(/\.(png|jpg|jpeg|mp3|ogg|wav|wasm|js|css)$/i)) {
                this.addEventListener('load', function () {
                    try {
                        analyzeData(this.responseText || '', this.status);
                    } catch (e) {}
                });
                this.addEventListener('error', function () {
                    markConnectionLost('XHR 錯誤');
                });
                this.addEventListener('timeout', function () {
                    markConnectionLost('XHR 逾時');
                });
            }
            return origSend.apply(this, arguments);
        };
    }

    if (!window.__dsFetchHooked) {
        window.__dsFetchHooked = true;
        const origFetch = window.fetch;
        window.fetch = async function (resource, init) {
            const url = (typeof resource === 'string') ? resource : (resource && resource.url ? resource.url : '');
            try {
                const response = await origFetch.apply(this, arguments);
                if (url && !url.match(/\.(png|jpg|jpeg|mp3|ogg|wav|wasm|js|css)$/i)) {
                    const clone = response.clone();
                    clone.text().then(text => analyzeData(text, response.status)).catch(() => {
                        if (!response.ok && (response.status >= 500 || response.status === 408 || response.status === 429)) {
                            markConnectionLost(`HTTP ${response.status}`);
                        }
                    });
                } else if (!response.ok && (response.status >= 500 || response.status === 408 || response.status === 429)) {
                    markConnectionLost(`HTTP ${response.status}`);
                }
                return response;
            } catch (err) {
                await markConnectionLost('網路請求失敗');
                throw err;
            }
        };
    }

    const panel = document.createElement('div');
    panel.id = 'ds-temper-helper';
    panel.style.cssText = `
        position: fixed; top: 10px; left: 10px; width: 360px;
        background: rgba(24, 18, 12, 0.95); border: 1px solid #7a5c32;
        border-radius: 6px; color: #e6d5b8; font-family: "Microsoft JhengHei", sans-serif;
        font-size: 12px; z-index: 999999; box-shadow: 0 4px 20px rgba(0,0,0,0.8); user-select: none;
    `;

    panel.innerHTML = `
        <div id="ds-header" style="padding: 6px 10px; background: #261b10; border-bottom: 1px solid #4a351d; display: flex; justify-content: space-between; align-items: center; cursor: move; border-radius: 6px 6px 0 0;">
            <span id="ds-title-text" style="font-weight: bold; color: #f0c065; font-size: 13px;">⚒️ 自動淬煉助手 v47.41</span>
            <div style="display: flex; align-items: center; gap: 5px;">
                <span id="ds-minimize" style="cursor: pointer; color: #f0c065; font-weight: bold; font-size: 13px; padding: 0 3px; background: #3a2a18; border: 1px solid #6e502b; border-radius: 3px;" title="縮小/展開">➖</span>
                <span id="ds-close" style="cursor: pointer; color: #aaa; font-weight: bold; padding: 0 2px;" title="關閉">✕</span>
            </div>
