    function applyAndResetManualCalibrationCounts() {
        const hits1El = document.getElementById('ds-sync-hits1');
        const hits2El = document.getElementById('ds-sync-hits2');
        const totalEl = document.getElementById('ds-sync-total');

        const s1 = Math.max(0, parseInt(hits1El ? hits1El.value : 0) || 0);
        const s2 = Math.max(0, parseInt(hits2El ? hits2El.value : 0) || 0);
        const stotal = Math.max(0, parseInt(totalEl ? totalEl.value : 0) || 0);

        const affix1 = document.getElementById('ds-target-affix1').value.trim().toLowerCase();
        const affix2 = document.getElementById('ds-target-affix2').value.trim().toLowerCase();

        const nextForgeT = {};
        if (affix1 && s1 > 0) nextForgeT[affix1] = s1;
        if (affix2 && s2 > 0) nextForgeT[affix2] = s2;

        const currentHitSum = Object.values(nextForgeT).reduce((acc, v) => acc + (parseInt(v) || 0), 0);
        const remainingTries = Math.max(0, stotal - currentHitSum);
        if (remainingTries > 0) {
            nextForgeT['_other'] = remainingTries;
        }

        window.__dsLatestForgeT = nextForgeT;

        if (hits1El) hits1El.value = 0;
        if (hits2El) hits2El.value = 0;
        if (totalEl) totalEl.value = 0;

        updateUIOnPacket(null, '斷線校正同步並清零輸入框');
    }

