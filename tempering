    function simulateClick(x, y) {
        const target = document.elementFromPoint(x, y);
        if (!target) return;
        const opt = { bubbles: true, cancelable: true, view: window, clientX: x, clientY: y, button: 0, buttons: 1 };
        target.dispatchEvent(new PointerEvent('pointerdown', opt));
        target.dispatchEvent(new MouseEvent('mousedown', opt));
        setTimeout(() => {
            target.dispatchEvent(new PointerEvent('pointerup', opt));
            target.dispatchEvent(new MouseEvent('mouseup', opt));
            target.dispatchEvent(new MouseEvent('click', opt));
        }, 60);
    }

    const sleep = async (ms) => {
        const start = Date.now();
        while (Date.now() - start < ms) { if (!state.running) break; await new Promise(r => setTimeout(r, 50)); }
    };

    async function waitForOutcome(targetOutcome, timeoutMs = 4000) {
        const start = Date.now();
        while (Date.now() - start < timeoutMs) {
            if (!state.running) break;
            const last = window.__dsPacketLog[window.__dsPacketLog.length - 1];
            if (last && last.json && String(last.json.outcome).trim().toLowerCase() === targetOutcome.toLowerCase()) {
                return last;
            }
            await sleep(50);
        }
        return null;
    }

    async function executeClearRoutine() {
        window.__dsResetCount = (window.__dsResetCount || 0) + 1;
        document.getElementById('ds-status').innerText = `⚠️ 執行清除程序 (第${window.__dsResetCount}輪)`;

        const essenceInput = document.getElementById('ds-essence-count');
        if (essenceInput) {
            let currentEss = parseInt(essenceInput.value) || 0;
            if (currentEss > 0) essenceInput.value = currentEss - 1;
        }

        simulateClick(state.cancelPos.x, state.cancelPos.y); await sleep(1000);
        if (!state.running) return;
        simulateClick(state.charsiPos.x, state.charsiPos.y); await sleep(1200);
        if (!state.running) return;
        simulateClick(state.npcClearPos.x, state.npcClearPos.y); await sleep(600);
        if (!state.running) return;

        if (!isInTemperInterface()) {
            await stopForNotInTemperInterface('清除點擊打勾前');
            return;
        }

        simulateClick(state.temperPos.x, state.temperPos.y); await sleep(300);
        simulateClick(state.temperPos.x, state.temperPos.y); 

        await waitForOutcome('cleaned', 5000);
        await sleep(400);

        // 點擊禁止關閉介面，若仍在介面中則再點一次，上限 5 次
        simulateClick(state.cancelPos.x, state.cancelPos.y); await sleep(1200);
        if (!state.running) return;

        let closeRetry = 0;
        while (state.running && isInTemperInterface()) {
            closeRetry++;
            if (closeRetry > CLEAR_CLOSE_MAX_RETRY) {
                state.running = false;
                const statusEl = document.getElementById('ds-status');
                if (statusEl) {
                    statusEl.innerText = `🛑 清除後仍在介面已達 ${CLEAR_CLOSE_MAX_RETRY} 次上限，已停止防卡死！`;
                    statusEl.style.color = '#e74c3c';
                }
                await sendTelegramNotice(`⚠️ D2 Survivors 警告：清除程序點擊禁止重試已達 ${CLEAR_CLOSE_MAX_RETRY} 次仍未離開介面，已自動停止以避免卡死！`);
                return;
            }
            const statusEl = document.getElementById('ds-status');
            if (statusEl) {
                statusEl.innerText = `⚠️ 仍在介面中，重試點擊禁止 (${closeRetry}/${CLEAR_CLOSE_MAX_RETRY})...`;
            }
            simulateClick(state.cancelPos.x, state.cancelPos.y);
            await sleep(900);
        }

        await sleep(800);
        window.__dsLatestForgeT = {};
        updateUIOnPacket(null, '輪數重置');
    }

    async function runLoop(options = {}) {
        const btn = document.getElementById('ds-toggle-btn');
        btn.innerText = '⏹ 停止自動淬煉';
        btn.style.background = 'linear-gradient(180deg, #6e2626 0%, #421414 100%)';

        let allowSkipNpcOnce = Boolean(options.skipNpcOpenIfInInterface);

        while (state.running) {
            let totalTries = 0;
            const forgeT = window.__dsLatestForgeT;
            for (let k in forgeT) { totalTries += (parseInt(forgeT[k]) || 0); }

            if (totalTries >= 10) {
                await executeClearRoutine();
                allowSkipNpcOnce = false;
                continue;
            }

            const mode = document.getElementById('ds-mode-select').value;
            const affix1 = document.getElementById('ds-target-affix1').value.trim().toLowerCase();
            const hits1 = parseInt(document.getElementById('ds-target-hits1').value) || 1;
            const affix2 = document.getElementById('ds-target-affix2').value.trim().toLowerCase();
            const hits2 = parseInt(document.getElementById('ds-target-hits2').value) || 1;
            const poolHits = parseInt(document.getElementById('ds-target-pool-hits').value) || 1;

            if (totalTries === 0 && Object.keys(forgeT).length === 0) {
                if (!isInTemperInterface()) {
                    document.getElementById('ds-status').innerText = '與恰西對話中...';
                    simulateClick(state.charsiPos.x, state.charsiPos.y); await sleep(1500);
                    if (!state.running) break;
                    document.getElementById('ds-status').innerText = '點擊選單[淬煉]...';
                    simulateClick(state.npcTemperPos.x, state.npcTemperPos.y); await sleep(800);
                    if (!state.running) break;
                }
            } else if (!allowSkipNpcOnce && !isInTemperInterface()) {
                document.getElementById('ds-status').innerText = '與恰西對話中...';
                simulateClick(state.charsiPos.x, state.charsiPos.y); await sleep(1500);
                if (!state.running) break;
                document.getElementById('ds-status').innerText = '點擊選單[淬煉]...';
                simulateClick(state.npcTemperPos.x, state.npcTemperPos.y); await sleep(800);
                if (!state.running) break;
            }
            allowSkipNpcOnce = false;

            if (!isInTemperInterface()) {
                await stopForNotInTemperInterface('點擊打勾前');
                break;
            }

            const essenceInput = document.getElementById('ds-essence-count');
            let currentEssence = parseInt(essenceInput ? essenceInput.value : 0) || 0;
            if (currentEssence <= 0) {
                state.running = false;
                document.getElementById('ds-status').innerText = '❌ 恐懼精華已歸零！';
                await sendTelegramNotice('⚠️ D2 Survivors 助手警示：恐懼精華已耗盡歸零，自動停止掛網！');
                break;
            }
            essenceInput.value = --currentEssence;

            const packetStartTime = Date.now();
            document.getElementById('ds-status').innerText = `執行淬煉 (精華剩餘:${currentEssence})...`;
            simulateClick(state.temperPos.x, state.temperPos.y);

            let targetPacket = null, start = Date.now();
            while (Date.now() - start < 4500) {
                if (!state.running) break;
                const pkts = window.__dsPacketLog;
                for (let i = pkts.length - 1; i >= 0; i--) {
                    if (pkts[i].time >= packetStartTime && pkts[i].isTemper) {
                        targetPacket = pkts[i];
                        break;
                    }
                }
                if (targetPacket) break;
                await sleep(50);
            }

            if (!state.running) break;

            if (!targetPacket) {
                if (!isInTemperInterface()) {
                    await stopForNotInTemperInterface('封包逾時且不在介面');
                    break;
                }
                state.running = false;
                await markConnectionLost('淬煉封包逾時無回應');
                break;
            }

            let c1 = (affix1 && forgeT[affix1]) ? forgeT[affix1] : 0;
            let c2 = (affix2 && forgeT[affix2]) ? forgeT[affix2] : 0;
            let remTries = 10 - totalTries;

            let needMore = false;
            if (mode === '1') {
                let n1 = affix1 ? Math.max(0, hits1 - c1) : 0;
                let n2 = affix2 ? Math.max(0, hits2 - c2) : 0;
                if (remTries < (n1 + n2)) needMore = true;
            } else {
                const rawPool = document.getElementById('ds-target-pool').value;
                const pool = parseAffixPool(rawPool);
                let poolSum = 0;
                pool.forEach(p => { poolSum += (forgeT[p] || 0); });
                if (remTries < Math.max(0, poolHits - poolSum)) needMore = true;
            }

            if (needMore) {
                document.getElementById('ds-status').innerText = '🛑 止損觸發：剩餘次數不足，執行清除...';
                await executeClearRoutine();
                continue;
            }

            let isComplete = false;
            if (mode === '1') {
                if (affix1 || affix2) {
                    if ((!affix1 || c1 >= hits1) && (!affix2 || c2 >= hits2)) isComplete = true;
                }
            } else {
                const rawPool = document.getElementById('ds-target-pool').value;
                const pool = parseAffixPool(rawPool);
                let poolSum = 0;
                pool.forEach(p => { poolSum += (forgeT[p] || 0); });
                if (poolSum >= poolHits) isComplete = true;
            }

            if (isComplete) {
                state.running = false;
                document.getElementById('ds-status').innerText = '🎉 目標完全達成！';
                await sendTelegramNotice('🎉 D2 Survivors 捷報：自動淬煉目標已完全達成！快回遊戲收割裝備！');
                break;
            }
            await sleep(400);
        }

        btn.innerText = '▶ 開始自動淬煉';
        btn.style.background = 'linear-gradient(180deg, #4a351d 0%, #2e2010 100%)';
    }

    document.getElementById('ds-toggle-btn').onclick = () => {
        if (state.running) {
            state.running = false;
        } else {
            if (parseInt(document.getElementById('ds-essence-count').value) <= 0) {
                document.getElementById('ds-status').innerText = '❌ 恐懼精華不可為 0！'; return;
            }
            stopPassiveProbeLoop();
            window.__dsLatestForgeT = {};
            netState.isDisconnected = false;
            netState.initialAlertSent = false;
            netState.retryFailCount = 0;
            updateUIOnPacket(null, '重新開始，狀態已歸零');
            document.getElementById('ds-status').innerText = '🔄 狀態已重置，準備從點擊 NPC 開始...';
            state.running = true;
            runLoop({ skipNpcOpenIfInInterface: false });
        }
    };
})();
